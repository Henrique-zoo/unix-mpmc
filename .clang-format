
BasedOnStyle: LLVM

# Indentação
IndentWidth: 4
ContinuationIndentWidth: 4
UseTab: Never
TabWidth: 4

# Comprimento das linhas
ColumnLimit: 100

# Chaves no estilo Rust
BreakBeforeBraces: Attach

# Argumentos e parâmetros
AlignAfterOpenBracket: false

PackArguments:
  BinPack: OnePerLine

PackParameters:
  BinPack: OnePerLine

# Quebras em funções
BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: true

# Quebras em condicionais
BreakAfterOpenBracketIf: true
BreakBeforeCloseBracketIf: true

# Quebras em laços
BreakAfterOpenBracketLoop: true
BreakBeforeCloseBracketLoop: true

# Quebras em switch
BreakAfterOpenBracketSwitch: true
BreakBeforeCloseBracketSwitch: true

# Evitar blocos compactados
AllowShortFunctionsOnASingleLine: None
# Reservar if sem chaves em uma linha para retornos curtos.
# Retornos de structs com múltiplos campos inicializados usam uma linha por campo,
# vírgula final no inicializador e chaves no if.
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Never

# Condicionais e switch
SpaceBeforeParens: ControlStatements
IndentCaseLabels: true

# Ponteiros
PointerAlignment: Right
DerivePointerAlignment: false

# Includes
SortIncludes:
  Enabled: true
  IgnoreCase: false

IncludeBlocks: Regroup

IncludeCategories:
  - Regex: '^<'
    Priority: 1
  - Regex: '^"'
    Priority: 2

# Alinhamentos
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignOperands: DontAlign

# Operadores binários
BreakBeforeBinaryOperators: NonAssignment
