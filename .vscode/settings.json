{
  // Reconhecer headers como C
  "files.associations": {
    "*.h": "c"
  },

  // C
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },

  // Clang-Format
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",

  // Makefile
  "[makefile]": {
    "editor.defaultFormatter": "tooark.ark-format-makefile",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 2
  },

  // Configuração do formatador de Makefile
  "arkFormatMakefile.indentConditionals": true,
  "arkFormatMakefile.normalizeRecipePrefix": true,
  "arkFormatMakefile.alignAssignments": true,

  // Configurações gerais
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "json.format.keepLines": true,

  "[json][jsonc]": {
    "editor.detectIndentation": false,
    "editor.tabSize": 2,
    "editor.indentSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace"
  }
}
