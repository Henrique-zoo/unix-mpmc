# Doxygen configuration for unix-mpmc documentation.
PROJECT_NAME           = unix-mpmc
PROJECT_BRIEF          = "Múltiplos produtores e consumidores com IPC System V"
OUTPUT_DIRECTORY       = build/docs
OUTPUT_LANGUAGE        = Brazilian
INPUT_ENCODING         = UTF-8

INPUT                  = README.md docs include src
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
